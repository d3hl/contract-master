{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "if [ -n \"$ORCA_CLI_COMMAND\" ]; then c=\"$ORCA_CLI_COMMAND\"; elif [ -n \"$ORCA_DEV_REPO_ROOT\" ]; then c=orca-dev; else c=orca-ide; fi; exec \"$c\" skills get orchestration",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit|Bash|Agent|Task",
        "hooks": [
          {
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 -m contract_master.guard",
            "type": "command"
          }
        ]
      }
    ]
  }
}
