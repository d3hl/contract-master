{
  "permissions": {
    "deny": [
      "Agent(general-purpose)",
      "Agent(claude)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 -m contract_master.guard"
          }
        ]
      }
    ]
  }
}
