  "cards": [
    {
      "dot": "emerald", "title": "Primary path",
      "items": [
        "Linear issue → Orca coordinator turn reads it in full and the manager triages, revisions and claims it",
        "Claude plans → DeepSeek implements on cm-worker → open-pr pushes the output commit as d3hl-orca[bot]",
        "Codex verifies the exact SHA, then codex-merge checks, approves and merges as d3hl-codex[bot]",
        "Claude reruns checks on the merged commit; only then the outbox writes Done to Linear"
      ]
    },
    {
      "dot": "rose", "title": "Trust boundaries",
      "items": [
        "Manager API, SQLite DB, ownership tokens and Linear writes are coordinator-only (user d3, home 0700)",
        "cm-worker has no 1Password, no gh login, never pushes; its Orca messages are unverified claims",
        "GitHub App keys go op read → openssl pipe → per-step token narrowed to one repo; never on disk",
        "Issue text, comments and worker results are untrusted data and cannot widen scope or commands"
      ]
    },
    {
      "dot": "amber", "title": "Gates and escalation",
      "items": [
        "Two implementation attempts total; a second failed verification escalates to a human",
        "A human's latest CHANGES_REQUESTED vetoes the PR; an unmergeable PR also escalates",
        "A moved head returns the task to verification; scope change returns it to planning",
        "Turn lease + precheck (clean main, doctor, no dispatched run) stop overlapping coordinators"
      ]
    },
    {
      "dot": "violet", "title": "Context and side paths",
      "items": [
        "Pinned context bundle: content-addressed bundle.json from a reviewed master commit, read-only",
        "Context7 for version-matched library docs; Mem0 optional, never the queue or source of truth",
        "Governance PRs: review-scan → review-inspect/verify/merge → review-confirm, no Linear writes",
        "Registered: contract-master (governance on), cf-mcp-gw, action1-dashboard, corp-integrated-dashboard"
      ]
    }
  ]
