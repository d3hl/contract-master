{
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0",
      "type": "string"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "const": "claude",
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "context_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "read_documents": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "investigation_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "latest_handoff_read": {
      "type": "boolean"
    },
    "documentation_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "library_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "links": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^https://.+$"
            }
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "library_id",
          "version",
          "links",
          "notes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "task_id",
    "author",
    "revision",
    "steps",
    "context_digest",
    "read_documents",
    "investigation_evidence",
    "latest_handoff_read",
    "documentation_sources"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/d3hl/contract-master/contracts/v1/plan.schema.json",
  "title": "plan"
}
