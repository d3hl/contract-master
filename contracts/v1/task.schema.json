{
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0",
      "type": "string"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "issue_id": {
      "type": "string",
      "minLength": 1
    },
    "repo_id": {
      "type": "string",
      "minLength": 1
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "phase": {
      "type": "string",
      "enum": [
        "planning",
        "ready",
        "implementing",
        "verifying",
        "rework",
        "awaiting_review",
        "done",
        "escalated",
        "superseded"
      ]
    },
    "plan_revision": {
      "type": "integer",
      "minimum": 0
    },
    "context": {
      "type": "object",
      "properties": {
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_commit",
        "digest",
        "path"
      ],
      "additionalProperties": false
    },
    "allowed_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "required_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "plan": {
      "type": "object",
      "properties": {
        "version": {
          "const": "1.0",
          "type": "string"
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "const": "claude",
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "context_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "read_documents": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "investigation_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "latest_handoff_read": {
          "type": "boolean"
        },
        "documentation_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "library_id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "links": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^https://.+$"
                }
              },
              "notes": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "library_id",
              "version",
              "links",
              "notes"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "version",
        "task_id",
        "author",
        "revision",
        "steps",
        "context_digest",
        "read_documents",
        "investigation_evidence",
        "latest_handoff_read",
        "documentation_sources"
      ],
      "additionalProperties": false
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "execution_policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "check_commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "argv",
          "timeout_seconds"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "task_id",
    "issue_id",
    "repo_id",
    "base_commit",
    "phase",
    "plan_revision",
    "context",
    "allowed_scope",
    "acceptance_criteria",
    "required_checks",
    "plan",
    "attempt",
    "corrections",
    "execution_policy_digest",
    "check_commands"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/d3hl/contract-master/contracts/v1/task.schema.json",
  "title": "task"
}
