<mxfile host="drawio"><diagram id="agent-team" name="Agent team"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Multi-Agent AI Team: Roles, Responsibilities and Handoffs" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="845" height="40" as="geometry"/></mxCell><mxCell id="linear" value="&lt;b&gt;Linear&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Requirements · plans · progress · HANDOFF&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="200" height="70" as="geometry"/></mxCell><mxCell id="mgr" value="&lt;b&gt;contract-master manager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Registry · SQLite queue · workspace ownership · recovery · serialized Linear outbox&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;boundedLbl=1;size=10;" vertex="1" parent="1"><mxGeometry x="340" y="50" width="260" height="90" as="geometry"/></mxCell><mxCell id="human" value="&lt;b&gt;Human&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Escalations only · may veto a PR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="700" y="60" width="185" height="70" as="geometry"/></mxCell><mxCell id="orca" value="&lt;b&gt;Orca coordinator&lt;/b&gt; (turn runs on Claude) — sole scheduler: triage · assignment · sequencing · monitoring · escalation" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="845" height="56" as="geometry"/></mxCell><mxCell id="claude1" value="&lt;b&gt;Claude&lt;/b&gt;&lt;br&gt;&lt;i&gt;Plan&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Investigate code, design options, record bounded plan&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="170" height="110" as="geometry"/></mxCell><mxCell id="deepseek" value="&lt;b&gt;DeepSeek&lt;/b&gt;&lt;br&gt;&lt;i&gt;Implement&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Scoped code + tests, apply corrections&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="265" y="320" width="170" height="110" as="geometry"/></mxCell><mxCell id="codex" value="&lt;b&gt;Codex&lt;/b&gt;&lt;br&gt;&lt;i&gt;Verify · Review · Merge&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Read diff, run checks at exact SHA, approve + merge&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="490" y="320" width="170" height="110" as="geometry"/></mxCell><mxCell id="claude2" value="&lt;b&gt;Claude&lt;/b&gt;&lt;br&gt;&lt;i&gt;Confirm Done&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Check merge facts, rerun checks, final acceptance&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="715" y="320" width="170" height="110" as="geometry"/></mxCell><mxCell id="repo" value="&lt;b&gt;Target repository / GitHub PR&lt;/b&gt; — product code, tests, architecture, API contracts" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="845" height="50" as="geometry"/></mxCell><mxCell id="e1" value="full reads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.119;entryY=0;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;labelPlacement=auto;" edge="1" parent="1" source="linear" target="orca"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="state · ownership" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.509;entryY=0;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;labelPlacement=auto;" edge="1" parent="1" source="mgr" target="orca"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="sole writer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;verticalAlign=bottom;labelPlacement=auto;" edge="1" parent="1" source="mgr" target="linear"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="escalate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#b85450;fontColor=#B20000;exitX=0.892;exitY=0;entryX=0.5;entryY=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;labelPlacement=auto;" edge="1" parent="1" source="orca" target="human"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d1" value="assign" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;exitX=0.101;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;labelPlacement=auto;" edge="1" parent="1" source="orca" target="claude1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d2" value="dispatch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;exitX=0.367;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;labelPlacement=auto;" edge="1" parent="1" source="orca" target="deepseek"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d3" value="dispatch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;exitX=0.633;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;labelPlacement=auto;" edge="1" parent="1" source="orca" target="codex"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d4" value="assign" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;exitX=0.899;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;labelPlacement=auto;" edge="1" parent="1" source="orca" target="claude2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h1" value="plan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#6c8ebf;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;verticalAlign=bottom;labelPlacement=auto;" edge="1" parent="1" source="claude1" target="deepseek"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h2" value="SHA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#6c8ebf;exitX=1;exitY=0.3;entryX=0;entryY=0.3;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;verticalAlign=bottom;labelPlacement=auto;" edge="1" parent="1" source="deepseek" target="codex"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h3" value="rework ≤2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#b85450;fontColor=#B20000;exitX=0;exitY=0.75;entryX=1;entryY=0.75;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;labelPlacement=auto;" edge="1" parent="1" source="codex" target="deepseek"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h4" value="merged" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#82b366;fontColor=#2D7600;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;verticalAlign=bottom;labelPlacement=auto;" edge="1" parent="1" source="codex" target="claude2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r1" value="commits" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.367;entryY=0;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;labelPlacement=auto;" edge="1" parent="1" source="deepseek" target="repo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r2" value="approve + merge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.633;entryY=0;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;labelPlacement=auto;" edge="1" parent="1" source="codex" target="repo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r3" value="rerun checks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.899;entryY=0;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;labelPlacement=auto;" edge="1" parent="1" source="claude2" target="repo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r0" value="reads code" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.101;entryY=0;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;labelPlacement=auto;" edge="1" parent="1" source="claude1" target="repo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="Legend: &lt;b&gt;thick blue&lt;/b&gt; = phase handoff · &lt;font color=&quot;#B20000&quot;&gt;red&lt;/font&gt; = rework / escalation (2 attempts max, then human) · dashed = Orca dispatch · Done only after Codex merge + Claude confirmation" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="845" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
